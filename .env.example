# =========================================================================
# Variables del stack Tyted — copia a `.env` y completa (local) o pégalas
# como variables de entorno del servicio en Coolify (servidor).
# `.env` está en .gitignore: NUNCA subas contraseñas al repo.
# =========================================================================

# --- PostgreSQL (contenedor interno, sin puertos públicos) ---
POSTGRES_PASSWORD=cambia-esta-password-larga-y-aleatoria

# --- API ---
# Clave JWT: MÍNIMO 32 caracteres (usa 48+). Ejemplo para generar una:
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_KEY=

# Origen del frontend según lo ve el navegador.
#   Local:  http://localhost:8080
#   Prod:   https://tu-dominio.com   (Coolify: AllowedOrigins__0)
APP_ORIGIN=http://localhost:8080

# Password del admin creado en el primer arranque (semilla).
# Si se omite NO se crea ningún usuario admin (opcional).
ADMIN_SEED_PASSWORD=

# --- Backups (contenedor backup) ---
BACKUP_KEEP_DAYS=7


# --- Respaldos off-site (Cloudflare R2, API S3) ---
# Bucket: tyted-backups (10 GB gratis) - Token: Object Read & Write.
# Endpoint = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Si vacias S3_ENDPOINT / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY el
# backup sigue funcionando, pero SOLO en local (el log lo avisara).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=tyted-backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Retencion de los dumps EN R2 (dias; 0 = no podar). Local: BACKUP_KEEP_DAYS.
S3_KEEP_DAYS=30

# --- Monitoreo ---
# Monitor Push de Uptime Kuma: URL de ping que dispara el backup tras un
# ciclo OK (si no llega el ping en 25 h - alerta de backup perdido).
# Obtener la URL en Uptime Kuma - monitor Push - copiar la URL.
BACKUP_PUSH_URL=